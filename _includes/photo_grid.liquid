<div class="photo-grid">
{% assign files = site.static_files | where_exp: "f", "f.path contains include.dir" %}
{% for photo in files %}
  {% assign ext = photo.extname | downcase %}
  {% if photo.name == '.gitkeep' or photo.name == '.DS_Store' or ext == '.webp' %}
    {% continue %}
  {% elsif ext == '.mp4' or ext == '.mov' or ext == '.webm' %}
  <video controls muted playsinline preload="metadata"><source src="{{ photo.path | relative_url }}"></video>
  {% elsif ext == '.jpg' or ext == '.jpeg' or ext == '.png' or ext == '.tiff' or ext == '.gif' %}
    {% assign base = photo.path | remove: photo.extname %}
    {% assign small = base | append: '-480.webp' | relative_url %}
    {% assign medium = base | append: '-800.webp' | relative_url %}
    {% assign large = base | append: '-1400.webp' | relative_url %}
  <img src="{{ small }}" srcset="{{ small }} 480w, {{ medium }} 800w, {{ large }} 1400w" sizes="220px" data-zoomable data-zoom-src="{{ photo.path | relative_url }}" alt="" loading="lazy">
  {% else %}
  <img src="{{ photo.path | relative_url }}" alt="" loading="lazy">
  {% endif %}
{% endfor %}
</div>
