<swiper-container class="home-cycler" loop="true" pagination="true" navigation="true" slides-per-view="1" autoplay-delay="3500">
{% assign carousel_dirs = "assets/img/experimental/,assets/img/personal/" | split: "," %}
{% for dir in carousel_dirs %}
  {% assign files = site.static_files | where_exp: "f", "f.path contains dir" %}
  {% for photo in files %}
    {% assign ext = photo.extname | downcase %}
    {% if photo.name == '.gitkeep' or photo.name == '.DS_Store' or ext == '.webp' or ext == '.mov' or ext == '.mp4' or ext == '.webm' %}
      {% continue %}
    {% endif %}
    {% assign base = photo.path | remove: photo.extname %}
  <swiper-slide><img src="{{ base | append: '-1400.webp' | relative_url }}" alt="" loading="lazy"></swiper-slide>
  {% endfor %}
{% endfor %}
</swiper-container>
